---
import IconLogo from './IconLogo.astro';

const links = [
  { number: '01', label: 'About',      href: '/#about' },
  { number: '02', label: 'Experience', href: '/#experience' },
  { number: '03', label: 'Work',       href: '/#work' },
  { number: '04', label: 'Blog',       href: '/#blog' },
  { number: '05', label: 'Contact',    href: '/#contact' },
];

const resumeUrl = 'https://drive.google.com/file/d/1OPF5zC-sCm9-UFFYBOq7DJSf-xrYqMsI/view?usp=sharing';
---

<header class="sticky top-0 z-50 bg-navy/90 backdrop-blur-sm">
  <nav class="flex items-center justify-between px-8 py-4 lg:px-16">

    <a href="/" class="text-accent hover:text-accent/80 transition-colors" aria-label="Home">
      <IconLogo />
    </a>

    {/* Hamburger (mobile only) */}
    <button id="menu-toggle" class="relative z-40 flex flex-col gap-1.5 md:hidden" aria-label="Toggle menu">
      <span id="line1" class="h-0.5 w-6 bg-accent transition-all duration-300 origin-center"></span>
      <span id="line2" class="h-0.5 w-6 bg-accent transition-all duration-300"></span>
      <span id="line3" class="h-0.5 w-6 bg-accent transition-all duration-300 origin-center"></span>
    </button>

    {/* Desktop nav */}
    <div class="hidden items-center gap-8 md:flex">
      <ol class="flex items-center gap-8 font-mono text-xs">
        {links.map((link) => (
          <li>
            <a href={link.href} class="text-lightest-slate transition-colors hover:text-accent">
              <span class="text-accent">{link.number}.</span> {link.label}
            </a>
          </li>
        ))}
      </ol>
      <a
        href={resumeUrl}
        target="_blank"
        rel="noreferrer"
        class="rounded border border-accent px-4 py-2 font-mono text-xs text-accent transition-all hover:-translate-y-0.5 hover:bg-accent/10"
      >
        Resume
      </a>
    </div>

    {/* Mobile nav drawer */}
    <ul
      id="nav-menu"
      class="absolute top-full left-0 right-0 hidden flex-col gap-6 border-b border-lightest-navy/40 bg-navy/95 p-8 font-mono text-sm backdrop-blur-sm"
    >
      {links.map((link) => (
        <li>
          <a href={link.href} class="block text-lightest-slate hover:text-accent transition-colors">
            <span class="text-accent">{link.number}.</span> {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={resumeUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-block rounded border border-accent px-5 py-3 text-accent hover:bg-accent/10"
        >
          Resume
        </a>
      </li>
    </ul>

  </nav>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const navMenu   = document.getElementById('nav-menu');
  const line1     = document.getElementById('line1');
  const line2     = document.getElementById('line2');
  const line3     = document.getElementById('line3');

  function openMenu() {
    navMenu?.classList.remove('hidden');
    navMenu?.classList.add('flex');
    navMenu!.style.animation = 'slideDown 0.25s ease-out forwards';
    line1!.style.transform   = 'rotate(45deg) translateY(8px)';
    line2!.style.opacity     = '0';
    line3!.style.transform   = 'rotate(-45deg) translateY(-8px)';
  }

  function closeMenu() {
    navMenu!.style.animation = 'slideUp 0.25s ease-out forwards';
    line1!.style.transform   = 'rotate(0)';
    line2!.style.opacity     = '1';
    line3!.style.transform   = 'rotate(0)';
    setTimeout(() => {
      navMenu?.classList.add('hidden');
      navMenu?.classList.remove('flex');
    }, 250);
  }

  menuToggle?.addEventListener('click', () => {
    navMenu?.classList.contains('hidden') ? openMenu() : closeMenu();
  });

  navMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>

<style>
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes slideUp {
    from { opacity: 1; transform: translateY(0); }
    to   { opacity: 0; transform: translateY(-8px); }
  }
</style>
