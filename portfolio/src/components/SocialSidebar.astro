---
import IconGithub from './IconGithub.astro';
import IconLinkedin from './IconLinkedin.astro';
---

<div class="fixed bottom-0 left-6 z-10 hidden flex-col items-center gap-5 md:flex xl:left-10">
  <a
    href="https://github.com/pavanmp140102/"
    target="_blank"
    rel="noreferrer"
    aria-label="GitHub"
    class="text-slate transition-all hover:-translate-y-1 hover:text-accent"
  >
    <IconGithub />
  </a>
  <a
    href="https://www.linkedin.com/in/pavanpatil72826"
    target="_blank"
    rel="noreferrer"
    aria-label="LinkedIn"
    class="text-slate transition-all hover:-translate-y-1 hover:text-accent"
  >
    <IconLinkedin />
  </a>
  <div class="h-24 w-px bg-slate"></div>
</div>
