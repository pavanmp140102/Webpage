---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SocialSidebar from '../components/SocialSidebar.astro';
import EmailSidebar from '../components/EmailSidebar.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import Experience from '../sections/Experience.astro';
import Work from '../sections/Work.astro';
import Blog from '../sections/Blog.astro';
import Contact from '../sections/Contact.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pavan Patil | Robotics Engineer</title>
    <meta name="description" content="Robotics engineer specializing in autonomous systems, perception, and real-world robotic applications." />
    <link rel="icon" type="image/png" href="/assets/logo.png" />
    <meta property="og:title" content="Pavan Patil | Robotics Engineer" />
    <meta property="og:description" content="Robotics engineer specializing in autonomous systems, perception, and real-world robotic applications." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pavanmp140102.github.io" />
    <script data-goatcounter="https://pavanmp1402.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <Navbar />
    <SocialSidebar />
    <EmailSidebar />
    <main>
      <Hero />
      <About />
      <Experience />
      <Work />
      <Blog />
      <Contact />
    </main>
    <Footer />
  </body>
</html>
